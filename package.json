{
  "name": "lovable-portfolio-audit",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run --pool=threads",
    "build:cli": "cd packages/cli && npm run build",
    "build:ext": "echo 'Extension: load unpacked from ./extension in Chrome'",
    "check:drift": "npm run build:cli && node scripts/check-pattern-drift.mjs",
