# Normalize line endings: store everything as LF in the repo, check out native.
* text=auto eol=lf

# Explicit text types (defensive; covered by text=auto above)
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Binary — never touch EOL or diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.crx   binary
*.woff  binary
*.woff2 binary
