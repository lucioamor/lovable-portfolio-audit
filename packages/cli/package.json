{
  "name": "@nxlv-ai/lovable-audit",
  "version": "1.0.1",
  "description": "Independent production-readiness security audit for Lovable apps — access control, Supabase RLS, exposed secrets, and more",
  "type": "module",
  "bin": {
    "nxlv-audit": "dist/index.js",
    "lovable-audit": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "lovable",
    "supabase",
    "security",
    "scanner",
    "rls",
    "bola",
    "audit",
    "vibe-coding"
  ],
  "author": "Lucio Amorim (Lovable Ambassador) <https://linkedin.com/in/lucioamorim>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lucioamor/lovable-portfolio-audit#readme",
  "bugs": {
    "url": "https://github.com/lucioamor/lovable-portfolio-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucioamor/lovable-portfolio-audit.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
